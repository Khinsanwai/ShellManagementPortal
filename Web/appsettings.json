{
  "Serilog": {
    "Using": [ "Serilog.Sinks.File", "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollOnFileSizeLimit": true,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter,Serilog.Formatting.Compact",
          "rollingInterval": "Day"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithThreadId", "WithMachineName" ]
  },
  "AllowedHosts": "*",
  "SMPConfig": {
    "Url": "https://localhost:7203/api/v1/{0}",
    "IamUrl": "http://localhost:5107/api/v1/{0}",
    "BaseRouteUrl": "/"
  },
  "WSO2": {
    "OidcAuthority": "https://192.168.120.188:9443/t/carbon.super/oauth2/oidcdiscovery",
    "Authority": "https://192.168.120.188:9443/t/carbon.super/oauth2/token",
    "ClientId": "Pj1KmSKNXdgW1O7gTP9MW4uo4S8a",
    "ClientSecret": "G0nfgvpN1fe2LnIfIE1v2whHffZda7WLKPLghVcJzi0a",
    "AdminUser": "596ec47d-0a8c-4ca8-b1ca-ff540ea865c2",
    "AdminPassword": "admin",
    "RevokeEndPoint": "https://192.168.120.188:9443/t/carbon.super/oauth2/revoke",
    "TokenEndPoint": "https://192.168.120.188:9443/t/carbon.super/oauth2/token",
    "ScimBaseUrl": "https://192.168.120.188:9443/t/carbon.super/scim2",
    "RedirectUri": "https://localhost:7067/signin-oidc",
  "ApiResourceScopes": [
    "TEST:READ",
    "TEST:WRITE",
    "TEST:DELETE",
    "Product:Read",
    "Product:Write",
    "Product:List",
    "Product:Delete"
  ]
}
