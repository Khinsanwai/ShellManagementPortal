@using ShellMgmt.Web.Constants
@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IHttpContextAccessor Context
@inject IConfiguration Configuration
@inject Wso2Service Wso2Service
@inject MenuService MenuService

<RadzenComponents />

<RadzenLayout style="grid-template-areas: 'rz-sidebar rz-header' 'rz-sidebar rz-body';">
    <RadzenHeader>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0">
            <RadzenSidebarToggle Click="@SidebarToggleClick" />
            <RadzenStack AlignItems="AlignItems.Center" Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" class="rz-ml-auto rz-mr-2">
                <RadzenAppearanceToggle />
                <RadzenProfileMenu Visible="@(Context.HttpContext?.User.Identity?.IsAuthenticated ?? false)" Click="@ProfileMenuClick">
                    <ChildContent>
                        <RadzenProfileMenuItem Text="Change Password" Value="ChangePassword" Icon="vpn_key" />
                        <RadzenProfileMenuItem Text="Logout" Value="Logout" Icon="power_settings_new" />
                    </ChildContent>
                    <Template>
                        @(userDisplayName ?? Context.HttpContext?.User.Identity?.Name ?? "User")
                    </Template>
                </RadzenProfileMenu>
            </RadzenStack>
        </RadzenStack>
    </RadzenHeader>
    <RadzenBody Expanded="@sidebarExpanded" Style="padding:0; overflow: auto;">
        @Body
    </RadzenBody>
    <RadzenSidebar Expanded="@sidebarExpanded" style="z-index: 2">
        @* Debug Info *@
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" class="rz-m-2" AllowClose="false">
            <small>
                <strong>Debug:</strong><br/>
                Name: @(userDisplayName ?? Context.HttpContext?.User.Identity?.Name ?? "null")<br/>
                Sub: @(Context.HttpContext?.User.FindFirst("sub")?.Value ?? "null")<br/>
                AdminUser (config): @(Configuration["WSO2:AdminUser"] ?? "null")<br/>
                IsAdmin: @(isUserAdmin ? "YES" : "NO")<br/>
                Authenticated: @(Context.HttpContext?.User.Identity?.IsAuthenticated ?? false)<br/>
                Menus: @(menuItems?.Count ?? 0)<br/>
            </small>
        </RadzenAlert>
        <MenuItemPanel MenuItems="@(menuItems ?? new List<MenuItemDto>())" />
    </RadzenSidebar>
</RadzenLayout>
