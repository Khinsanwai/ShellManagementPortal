@page "/groups"
@attribute [Authorize]
@inject ApiService ApiService
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject NavigationManager NavigationManager

<PageTitle>Groups - Shell Management Portal</PageTitle>

<RadzenRow class="rz-p-4">
    <RadzenColumn Size="12">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
                <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("/"))" Tooltip="Return to Dashboard" />
                <RadzenText TextStyle="TextStyle.H4">Groups</RadzenText>
            </RadzenStack>
            <RadzenButton Text="Add Group" Icon="add" Click="@CreateGroup" />
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>

<RadzenDataGrid @ref="grid" Data="@groups" TItem="GroupDto" AllowSorting="true" AllowPaging="true" PageSize="10"
                ShowPagingSummary="true">
    <Columns>
        <RadzenDataGridColumn TItem="GroupDto" Property="DisplayName" Title="Display Name" Sortable="true" Width="250px">
            <Template Context="g">
                <strong>@g.DisplayName</strong>
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GroupDto" Title="Members" Sortable="false">
            <Template Context="g">
                @if (g.MemberDisplayNames.Any())
                {
                    var display = string.Join(", ", g.MemberDisplayNames.Take(3));
                    @display
                    if (g.MemberDisplayNames.Count > 3)
                    {
                        <span> ... (@g.MemberDisplayNames.Count total)</span>
                    }
                }
                else
                {
                    <em class="rz-text-secondary">No members</em>
                }
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GroupDto" Property="CreatedDate" Title="Created Date" Sortable="true">
            <Template Context="g">
                @g.CreatedDate.ToString("yyyy-MM-dd HH:mm")
            </Template>
        </RadzenDataGridColumn>
        <RadzenDataGridColumn TItem="GroupDto" Title="Actions" Width="180px">
            <Template Context="g">
                <RadzenButton Icon="edit" Size="ButtonSize.Small" Tooltip="Edit" Click="@(() => EditGroup(g))" />
                <RadzenButton Icon="delete" Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Danger" Tooltip="Delete"
                              Click="@(() => DeleteGroup(g))" />
            </Template>
        </RadzenDataGridColumn>
    </Columns>
</RadzenDataGrid>

@code {
    RadzenDataGrid<GroupDto>? grid;
    List<GroupDto>? groups;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            var result = await ApiService.GetAsync<GroupListResponse>("group/get", AppConfig.AccessToken);
            groups = result?.Items;
            if (grid != null) await grid.Reload();
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to load groups: {ex.Message}");
        }
    }

    private async Task CreateGroup()
    {
        var result = await DialogService.OpenAsync<GroupForm>("Add Group",
            new Dictionary<string, object?> { { "IsEdit", false } },
            new DialogOptions { Width = "450px", Resizable = true, Draggable = true });
        if (result == true) await ReloadData();
    }

    private async Task EditGroup(GroupDto group)
    {
        var result = await DialogService.OpenAsync<GroupForm>("Edit Group",
            new Dictionary<string, object?> { { "IsEdit", true }, { "GroupId", group.Id }, { "ExistingName", group.DisplayName } },
            new DialogOptions { Width = "450px", Resizable = true, Draggable = true });
        if (result == true) await ReloadData();
    }

    private async Task DeleteGroup(GroupDto group)
    {
        var confirmed = await DialogService.Confirm(
            $"Are you sure you want to delete group '{group.DisplayName}'?\n\nThis action cannot be undone.",
            "Delete Group",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            try
            {
                await ApiService.DeleteAsync($"group/delete/{group.Id}", AppConfig.AccessToken);
                NotificationService.Notify(NotificationSeverity.Success, "Deleted", $"Group '{group.DisplayName}' deleted successfully");
                await ReloadData();
            }
            catch (Exception ex)
            {
                NotificationService.Notify(NotificationSeverity.Error, "Error", $"Failed to delete group: {ex.Message}");
            }
        }
    }

    private async Task ReloadData()
    {
        if (grid != null) await grid.Reload();
        else await LoadData();
    }

    public class GroupListResponse
    {
        public List<GroupDto> Items { get; set; } = new();
        public int Total { get; set; }
    }
}
