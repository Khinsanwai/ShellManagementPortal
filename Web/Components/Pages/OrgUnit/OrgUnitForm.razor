@inject ApiService ApiService
@inject NotificationService NotificationService
@inject DialogService DialogService

<RadzenTemplateForm Data="@model" TItem="OrgUnitDto" Submit="@OnSubmit">
    <RadzenStack Gap="1rem">
        <RadzenFormField Text="Name">
            <RadzenTextBox @bind-Value="model.Name" Name="Name" />
            <RadzenRequiredValidator Component="Name" Text="Name is required" />
        </RadzenFormField>
        <RadzenFormField Text="Parent Unit ID">
            <RadzenTextBox @bind-Value="parentUnitIdStr" />
        </RadzenFormField>
        <RadzenFormField Text="Description">
            <RadzenTextBox @bind-Value="model.Description" />
        </RadzenFormField>
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
            <RadzenButton Text="Save" ButtonType="ButtonType.Submit" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public Guid? OrgUnitId { get; set; }

    private OrgUnitDto model = new();
    private string parentUnitIdStr = "";

    protected override async Task OnInitializedAsync()
    {
        if (OrgUnitId.HasValue)
        {
            var result = await ApiService.GetAsync<PagedList<OrgUnitDto>>($"orgunit/get?Id={OrgUnitId}", AppConfig.AccessToken);
            model = result?.Items?.FirstOrDefault() ?? new OrgUnitDto();
            parentUnitIdStr = model.ParentUnitId?.ToString() ?? "";
        }
    }

    private async Task OnSubmit(OrgUnitDto item)
    {
        if (Guid.TryParse(parentUnitIdStr, out var parentGuid))
            model.ParentUnitId = parentGuid;

        if (OrgUnitId.HasValue)
        {
            await ApiService.PutAsync("orgunit/update", new { Id = OrgUnitId, item.Name, ParentUnitId = model.ParentUnitId, item.Description }, AppConfig.AccessToken);
            NotificationService.Notify(NotificationSeverity.Success, "Updated", "Org Unit updated successfully");
        }
        else
        {
            await ApiService.PostAsync("orgunit/create", item, AppConfig.AccessToken);
            NotificationService.Notify(NotificationSeverity.Success, "Created", "Org Unit created successfully");
        }
        DialogService.Close(true);
    }
}
