@using Microsoft.AspNetCore.Components
@using Radzen
@using Radzen.Blazor
@using ShellMgmt.Domain.AppModels
@using ShellMgmt.Domain.MenuItemModels
@inject NavigationManager NavigationManager

<RadzenStack AlignItems="Radzen.AlignItems.Center" JustifyContent="Radzen.JustifyContent.Start" class="rz-py-4 rz-py-lg-6" Style="padding: 5px;">
    <RadzenImage Path="images/mini-side-bar-logo.png" style="width: 100px; height: 90px;" AlternateText="Application logo" />
</RadzenStack>

@* Assigned Applications *@
@if (AssignedApps != null && AssignedApps.Any())
{
    <RadzenPanelMenu>
        <RadzenPanelMenuItem Text="Applications" Icon="apps" Expanded="true">
            @foreach (var app in AssignedApps)
            {
                <RadzenPanelMenuItem Text="@app.ApplicationName"
                                     Icon="@(GetAppIcon(app))"
                                     Path="@($"/app/{app.ApplicationId}")" />
            }
        </RadzenPanelMenuItem>
    </RadzenPanelMenu>
}

@* Dynamic Menu from Database *@
@if (MenuItems != null && MenuItems.Any())
{
    <RadzenPanelMenu>
        @foreach (var menu in MenuItems.Where(x => x.ParentId == null || x.ParentId == Guid.Empty).OrderBy(x => x.MenuOrder).ToList())
        {
            var childItems = MenuItems
                .Where(x => x.ParentId == menu.Id)
                .OrderBy(x => x.MenuOrder)
                .ToList();

            @if (childItems.Any())
            {
                @* Parent menu with children - expandable *@
                <RadzenPanelMenuItem Text="@menu.Name" Icon="@GetMenuIcon(menu.Name)">
                    @foreach (var item in childItems)
                    {
                        <RadzenPanelMenuItem Text="@item.Name" Icon="@GetMenuIcon(item.Name)" Path="@item.Url" />
                    }
                </RadzenPanelMenuItem>
            }
            else if (!string.IsNullOrEmpty(menu.Url))
            {
                @* Leaf menu item - clickable *@
                <RadzenPanelMenuItem Text="@menu.Name" Icon="@GetMenuIcon(menu.Name)" Path="@menu.Url" />
            }
        }
    </RadzenPanelMenu>
}
else if (AssignedApps == null || !AssignedApps.Any())
{
    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" class="rz-p-4">
        <RadzenIcon Icon="menu" Style="font-size: 48px; color: var(--rz-text-disabled-color);" />
        <RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary">No menus assigned</RadzenText>
    </RadzenStack>
}

@code {
    [Parameter]
    public List<MenuItemDto> MenuItems { get; set; } = [];

    [Parameter]
    public List<UserChildApplicationAssignmentDto> AssignedApps { get; set; } = [];

    private static string GetAppIcon(UserChildApplicationAssignmentDto app)
    {
        if (!string.IsNullOrEmpty(app.ApplicationIcon))
            return app.ApplicationIcon;
        return "apps";
    }

    private static string GetMenuIcon(string? name)
    {
        return name?.ToLower() switch
        {
            "dashboard" => "dashboard",
            "identity management" => "fingerprint",
            "organization management" => "corporate_fare",
            "application management" => "apps",
            "authorization management" => "lock",
            "system management" => "settings",
            "administration" => "admin_panel_settings",
            "settings" => "settings",
            "users" => "people",
            "user list" => "person",
            "claims" => "security",
            "institutions" => "account_balance",
            "organization" => "corporate_fare",
            "apps" => "apps",
            "menu items" => "menu",
            "user groups" => "group_add",
            "groups" => "group_add",
            "roles" => "admin_panel_settings",
            "resources" => "key",
            "tenants" => "business",
            "audit logs" => "history",
            "audit dashboard" => "dashboard",
            "user menu assignment" => "assignment",
            "user app assignment" => "assignment_ind",
            _ => "folder"
        };
    }
}
