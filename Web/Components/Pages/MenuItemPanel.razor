@using Microsoft.AspNetCore.Components
@using ShellMgmt.Domain.MenuItemModels
@inject NavigationManager NavigationManager

<RadzenStack AlignItems="Radzen.AlignItems.Center" JustifyContent="Radzen.JustifyContent.Start" class="rz-py-4 rz-py-lg-6" Style="padding: 5px;">
    <RadzenImage Path="images/logo.png" style="width: 150px; height: 50px;" AlternateText="Application logo" />
</RadzenStack>

@if (MenuItems != null)
{
    <RadzenTabs Orientation="Orientation.Vertical" RenderMode="TabRenderMode.Client">
        <Tabs>
            @foreach (var menu in MenuItems.Where(x => x.ParentId == null || x.ParentId == Guid.Empty).OrderBy(x => x.MenuOrder).ToList())
            {
                var childItems = MenuItems
                    .Where(x => x.ParentId == menu.Id)
                    .OrderBy(x => x.MenuOrder)
                    .ToList();

                @if (childItems.Any())
                {
                    <RadzenTabsItem Text="@menu.Name" Icon="@GetMenuIcon(menu.Name)">
                        <RadzenStack Gap="0.25rem">
                            @foreach (var item in childItems)
                            {
                                <RadzenButton Text="@item.Name" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                              class="rz-text-align-start rz-w-100" Click="@(() => OnMenuItemClick(item))" />
                            }
                        </RadzenStack>
                    </RadzenTabsItem>
                }
                else if (!string.IsNullOrEmpty(menu.Url))
                {
                    <RadzenTabsItem Text="@menu.Name" Icon="@GetMenuIcon(menu.Name)">
                        <RadzenButton Text="@($"Go to {menu.Name}")" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                                      Click="@(() => OnMenuItemClick(menu))" />
                    </RadzenTabsItem>
                }
            }
        </Tabs>
    </RadzenTabs>
}

@code {
    [Parameter]
    public List<MenuItemDto> MenuItems { get; set; } = [];

    private void OnMenuItemClick(MenuItemDto item)
    {
        if (!string.IsNullOrEmpty(item.Url))
        {
            NavigationManager.NavigateTo(item.Url);
        }
    }

    private static string GetMenuIcon(string? name)
    {
        return name?.ToLower() switch
        {
            "dashboard" => "dashboard",
            "administration" => "admin_panel_settings",
            "settings" => "settings",
            "users" => "people",
            "claims" => "security",
            "institutions" => "account_balance",
            "organization" => "corporate_fare",
            "apps" => "apps",
            "menu items" => "menu",
            "user groups" => "group_add",
            "resources" => "key",
            "tenants" => "business",
            _ => "folder"
        };
    }
}
