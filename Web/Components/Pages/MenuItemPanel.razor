@using Microsoft.AspNetCore.Components
@using Radzen
@using Radzen.Blazor
@using ShellMgmt.Domain.MenuItemModels
@inject NavigationManager NavigationManager

<RadzenStack AlignItems="Radzen.AlignItems.Center" JustifyContent="Radzen.JustifyContent.Start" class="rz-py-4 rz-py-lg-6" Style="padding: 5px;">
    <RadzenImage Path="images/logo.png" style="width: 150px; height: 50px;" AlternateText="Application logo" />
</RadzenStack>

@* Debug *@
<RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" class="rz-m-2" AllowClose="false">
    <small>MenuItemPanel received: @(MenuItems?.Count ?? 0) items</small>
</RadzenAlert>

@* Dynamic Menu from Database *@
@if (MenuItems != null && MenuItems.Any())
{
    <RadzenPanelMenu>
        @foreach (var menu in MenuItems.Where(x => x.ParentId == null || x.ParentId == Guid.Empty).OrderBy(x => x.MenuOrder).ToList())
        {
            var childItems = MenuItems
                .Where(x => x.ParentId == menu.Id)
                .OrderBy(x => x.MenuOrder)
                .ToList();

            @if (childItems.Any())
            {
                @* Parent menu with children - expandable *@
                <RadzenPanelMenuItem Text="@menu.Name" Icon="@GetMenuIcon(menu.Name)">
                    @foreach (var item in childItems)
                    {
                        <RadzenPanelMenuItem Text="@item.Name" Icon="@GetMenuIcon(item.Name)" Path="@item.Url" />
                    }
                </RadzenPanelMenuItem>
            }
            else if (!string.IsNullOrEmpty(menu.Url))
            {
                @* Leaf menu item - clickable *@
                <RadzenPanelMenuItem Text="@menu.Name" Icon="@GetMenuIcon(menu.Name)" Path="@menu.Url" />
            }
        }
    </RadzenPanelMenu>
}
else
{
    <RadzenStack Orientation="Orientation.Vertical" AlignItems="AlignItems.Center" JustifyContent="JustifyContent.Center" class="rz-p-4">
        <RadzenIcon Icon="menu" Style="font-size: 48px; color: var(--rz-text-disabled-color);" />
        <RadzenText TextStyle="TextStyle.Body1" class="rz-text-secondary">No menus assigned</RadzenText>
    </RadzenStack>
}

@code {
    [Parameter]
    public List<MenuItemDto> MenuItems { get; set; } = [];

    private static string GetMenuIcon(string? name)
    {
        return name?.ToLower() switch
        {
            "dashboard" => "dashboard",
            "administration" => "admin_panel_settings",
            "settings" => "settings",
            "users" => "people",
            "user list" => "person",
            "claims" => "security",
            "institutions" => "account_balance",
            "organization" => "corporate_fare",
            "apps" => "apps",
            "menu items" => "menu",
            "user groups" => "group_add",
            "groups" => "group_add",
            "resources" => "key",
            "tenants" => "business",
            "user menu assignment" => "assignment",
            _ => "folder"
        };
    }
}
