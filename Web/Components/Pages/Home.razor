@page "/"
@attribute [Authorize]

<PageTitle>Dashboard - Shell Management Portal</PageTitle>

<RadzenRow Gap="1rem" class="rz-p-4">
    <RadzenColumn Size="12">
        <RadzenText TextStyle="TextStyle.H4">Dashboard</RadzenText>
        <RadzenText TextStyle="TextStyle.Subtitle1">Welcome to the Shell Management Portal</RadzenText>
    </RadzenColumn>
</RadzenRow>

<RadzenRow Gap="1rem" class="rz-p-4">
    <RadzenColumn Size="3">
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenIcon Icon="menu" Style="font-size: 48px; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H6">Menu Items</RadzenText>
                <RadzenLink Path="/menuitems" Text="Manage" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenIcon Icon="security" Style="font-size: 48px; color: var(--rz-secondary);" />
                <RadzenText TextStyle="TextStyle.H6">Claims</RadzenText>
                <RadzenLink Path="/claims" Text="Manage" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenIcon Icon="account_balance" Style="font-size: 48px; color: var(--rz-success);" />
                <RadzenText TextStyle="TextStyle.H6">Institutions</RadzenText>
                <RadzenLink Path="/institutions" Text="Manage" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenIcon Icon="corporate_fare" Style="font-size: 48px; color: var(--rz-warning);" />
                <RadzenText TextStyle="TextStyle.H6">Org Units</RadzenText>
                <RadzenLink Path="/orgunits" Text="Manage" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<RadzenRow Gap="1rem" class="rz-p-4">
    <RadzenColumn Size="3">
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenIcon Icon="apps" Style="font-size: 48px; color: var(--rz-info);" />
                <RadzenText TextStyle="TextStyle.H6">Applications</RadzenText>
                <RadzenLink Path="/apps" Text="Manage" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenIcon Icon="key" Style="font-size: 48px; color: var(--rz-danger);" />
                <RadzenText TextStyle="TextStyle.H6">Resources</RadzenText>
                <RadzenLink Path="/resources" Text="Manage" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenIcon Icon="business" Style="font-size: 48px; color: var(--rz-primary);" />
                <RadzenText TextStyle="TextStyle.H6">Tenants</RadzenText>
                <RadzenLink Path="/tenants" Text="Manage" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
    <RadzenColumn Size="3">
        <RadzenCard>
            <RadzenStack AlignItems="AlignItems.Center">
                <RadzenIcon Icon="people" Style="font-size: 48px; color: var(--rz-secondary);" />
                <RadzenText TextStyle="TextStyle.H6">Users</RadzenText>
                <RadzenLink Path="/users" Text="Manage" />
            </RadzenStack>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>
