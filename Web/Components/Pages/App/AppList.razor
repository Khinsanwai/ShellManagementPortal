@page "/apps"
@attribute [Authorize]
@inject ApiService ApiService

<PageTitle>Applications - Shell Management Portal</PageTitle>

<RadzenRow class="rz-p-4">
    <RadzenColumn Size="12">
        <RadzenText TextStyle="TextStyle.H4">Applications</RadzenText>
    </RadzenColumn>
</RadzenRow>

<RadzenDataGrid @ref="grid" Data="@items" TItem="AppDto" AllowSorting="true" AllowPaging="true" PageSize="10">
    <Columns>
        <RadzenDataGridColumn TItem="AppDto" Property="Name" Title="Name" />
        <RadzenDataGridColumn TItem="AppDto" Property="Description" Title="Description" />
    </Columns>
</RadzenDataGrid>

@code {
    RadzenDataGrid<AppDto>? grid;
    IEnumerable<AppDto>? items;

    protected override async Task OnInitializedAsync()
    {
        var result = await ApiService.GetAsync<PagedList<AppDto>>("app/get", AppConfig.AccessToken);
        items = result?.Items;
    }
}
