@page "/menuitems"
@attribute [Authorize]
@inject ApiService ApiService
@inject NotificationService NotificationService
@inject DialogService DialogService

<PageTitle>Menu Items - Shell Management Portal</PageTitle>

<RadzenRow class="rz-p-4">
    <RadzenColumn Size="12">
        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.SpaceBetween" AlignItems="AlignItems.Center">
            <RadzenText TextStyle="TextStyle.H4">Menu Items</RadzenText>
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>

<RadzenDataGrid @ref="grid" Data="@items" TItem="MenuItemDto" AllowSorting="true" AllowPaging="true" PageSize="10">
    <Columns>
        <RadzenDataGridColumn TItem="MenuItemDto" Property="Name" Title="Name" />
        <RadzenDataGridColumn TItem="MenuItemDto" Property="Url" Title="URL" />
        <RadzenDataGridColumn TItem="MenuItemDto" Property="ParentId" Title="Parent ID" />
        <RadzenDataGridColumn TItem="MenuItemDto" Property="MenuOrder" Title="Order" />
    </Columns>
</RadzenDataGrid>

@code {
    RadzenDataGrid<MenuItemDto>? grid;
    IEnumerable<MenuItemDto>? items;

    protected override async Task OnInitializedAsync()
    {
        var result = await ApiService.GetAsync<PagedList<MenuItemDto>>("menuitem/get", AppConfig.AccessToken);
        items = result?.Items;
    }
}
