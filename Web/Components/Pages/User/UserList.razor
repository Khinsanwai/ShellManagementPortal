@page "/users"
@attribute [Authorize]

<PageTitle>Users - Shell Management Portal</PageTitle>

<RadzenRow class="rz-p-4">
    <RadzenColumn Size="12">
        <RadzenText TextStyle="TextStyle.H4">Users</RadzenText>
        <RadzenText TextStyle="TextStyle.Subtitle1">User management is handled through WSO2 Identity Server</RadzenText>
    </RadzenColumn>
</RadzenRow>

<RadzenCard class="rz-p-4">
    <RadzenText>
        Users are managed through the WSO2 Identity Server console.
        Please access the WSO2 admin console to create, update, or delete users.
    </RadzenText>
    <RadzenButton Text="Open WSO2 Console" Icon="open_in_new"
                  Click="@(() => NavigationManager.NavigateTo("https://localhost:9443/console", true))" />
</RadzenCard>

@code {
    [Inject] NavigationManager NavigationManager { get; set; } = default!;
}
