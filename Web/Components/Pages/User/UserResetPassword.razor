@inject ApiService ApiService
@inject NotificationService NotificationService
@inject DialogService DialogService

<RadzenTemplateForm Data="@model" TItem="PasswordResetModel" Submit="@OnSubmit">
    <RadzenStack Gap="1rem">
        <RadzenAlert AlertStyle="AlertStyle.Warning">
            Resetting password for user: <strong>@UserName</strong>
        </RadzenAlert>

        <RadzenFormField Text="New Password">
            <RadzenPassword @bind-Value="model.NewPassword" Name="NewPassword" />
            <RadzenRequiredValidator Component="NewPassword" Text="New password is required" />
            <RadzenText TextStyle="TextStyle.Caption" class="rz-text-secondary">
                Minimum 8 characters with uppercase, lowercase, and a number
            </RadzenText>
        </RadzenFormField>

        <RadzenFormField Text="Confirm Password">
            <RadzenPassword @bind-Value="model.ConfirmPassword" Name="ConfirmPassword" />
            <RadzenRequiredValidator Component="ConfirmPassword" Text="Please confirm the password" />
            <RadzenCompareValidator Component="ConfirmPassword" Text="Passwords do not match" CompareComponent="NewPassword" />
        </RadzenFormField>

        <RadzenRow>
            <RadzenColumn Size="12">
                <RadzenCheckBox @bind-Value="model.ForceChangeOnNextLogin" Label="Force password change on next login" />
            </RadzenColumn>
        </RadzenRow>

        <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.End" Gap="0.5rem">
            <RadzenButton Text="Cancel" ButtonStyle="ButtonStyle.Light" Click="@(() => DialogService.Close(false))" />
            <RadzenButton Text="Reset Password" ButtonType="ButtonType.Submit" ButtonStyle="ButtonStyle.Warning" />
        </RadzenStack>
    </RadzenStack>
</RadzenTemplateForm>

@code {
    [Parameter] public string UserId { get; set; } = string.Empty;
    [Parameter] public string UserName { get; set; } = string.Empty;

    private PasswordResetModel model = new();

    private async Task OnSubmit(PasswordResetModel passwordModel)
    {
        try
        {
            await ApiService.PostAsync($"user/ResetPassword/{UserId}", new
            {
                NewPassword = passwordModel.NewPassword
            }, AppConfig.AccessToken);

            NotificationService.Notify(NotificationSeverity.Success, "Success", $"Password reset successfully for {UserName}");
            DialogService.Close(true);
        }
        catch (Exception ex)
        {
            NotificationService.Notify(NotificationSeverity.Error, "Error", ex.Message);
        }
    }

    public class PasswordResetModel
    {
        public string NewPassword { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
        public bool ForceChangeOnNextLogin { get; set; }
    }
}
