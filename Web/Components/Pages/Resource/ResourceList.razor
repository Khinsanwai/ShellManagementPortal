@page "/resources"
@attribute [Authorize]
@inject ApiService ApiService
@inject NavigationManager NavigationManager

<PageTitle>Resources - Shell Management Portal</PageTitle>

<RadzenRow class="rz-p-4">
    <RadzenColumn Size="12">
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="1rem">
            <RadzenButton Icon="arrow_back" ButtonStyle="ButtonStyle.Light" Click="@(() => NavigationManager.NavigateTo("/"))" Tooltip="Return to Dashboard" />
            <RadzenText TextStyle="TextStyle.H4">Resources</RadzenText>
        </RadzenStack>
    </RadzenColumn>
</RadzenRow>

<RadzenDataGrid @ref="grid" Data="@items" TItem="ResourceDto" AllowSorting="true" AllowPaging="true" PageSize="10">
    <Columns>
        <RadzenDataGridColumn TItem="ResourceDto" Property="Name" Title="Name" />
        <RadzenDataGridColumn TItem="ResourceDto" Property="Description" Title="Description" />
        <RadzenDataGridColumn TItem="ResourceDto" Property="MenuItemId" Title="Menu Item ID" />
    </Columns>
</RadzenDataGrid>

@code {
    RadzenDataGrid<ResourceDto>? grid;
    IEnumerable<ResourceDto>? items;

    protected override async Task OnInitializedAsync()
    {
        var result = await ApiService.GetAsync<PagedList<ResourceDto>>("resource/get", AppConfig.AccessToken);
        items = result?.Items;
    }
}
